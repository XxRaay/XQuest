{
  "name": "xquest",
  "version": "1.0.0",
  "description": "Discord Quest & Orb Emulator — безопасная эмуляция запущенных игр и браузеров для квестов Discord без их установки",
  "main": "dist-electron/main.js",
  "author": "XxRaay",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://github.com/XxRaay/XQuest",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XxRaay/XQuest.git"
  },
  "bugs": {
    "url": "https://github.com/XxRaay/XQuest/issues"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build:stub": "node electron/stub/build-stub.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:ui": "vite build",
    "build": "npm run build:stub && npm run build:electron && npm run build:ui",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "dev:ui": "vite",
    "dev:electron": "cross-env NODE_ENV=development electron .",
    "prestart": "npm run build:electron",
    "start": "electron .",
    "dev": "concurrently -k -n \"UI,MAIN\" -c \"cyan,magenta\" \"vite\" \"cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.xxraay.xquest",
    "productName": "XQuest",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/stub/StubRunner.exe",
        "to": "stub/StubRunner.exe"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "dist-electron/stub/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName} Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "XQuest",
      "uninstallDisplayName": "XQuest",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
